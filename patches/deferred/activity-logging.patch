@@ -0,0 +1,69 @@
+import logger from '@server/logger';
+import { appDataPath } from '@server/utils/appDataVolume';
+import path from 'path';
+import type { ActivityEvent } from './userActivityPolicy';
+import { UserActivityStore, type ActivityFilter } from './userActivityStore';
+let store: UserActivityStore | undefined;
+const pending: ActivityEvent[] = [];
+let timer: ReturnType<typeof setTimeout> | undefined;
+let flushing: Promise<void> | undefined;
+let dropped = 0,
+  lastErrorAt: number | null = null;
+let lastWarningAt = 0;
+const recent = new Map<string, number>();
+const database = () =>
+  (store ??= new UserActivityStore(
+    path.join(appDataPath(), 'user-activity.sqlite3')
+  ));
+export function recordUserActivity(event: ActivityEvent) {
+  if (event.kind === 'page') {
+    const key = `${event.userId}:${event.session}:${event.target}`;
+    if (event.at - (recent.get(key) ?? 0) < 10000) return;
+    recent.set(key, event.at);
+    if (recent.size > 2000) recent.delete(recent.keys().next().value!);
+  }
+  if (pending.length >= 1000) {
+    dropped++;
+    return;
+  }
+  pending.push(event);
+  if (!timer) {
+    timer = setTimeout(() => {
+      timer = undefined;
+      void flushUserActivity();
+    }, 1000);
+    timer.unref();
+  }
+}
+export function flushUserActivity(): Promise<void> {
+  if (flushing) return flushing;
+  flushing = (async () => {
+    while (pending.length) {
+      const batch = pending.splice(0, 50);
+      try {
+        await database().append(batch);
+      } catch {
+        dropped += batch.length;
+        lastErrorAt = Date.now();
+        if (lastErrorAt - lastWarningAt >= 60000) {
+          lastWarningAt = lastErrorAt;
+          logger.warn('Usage activity could not be stored', {
+            label: 'Activity',
+            dropped,
+          });
+        }
+        break;
+      }
+    }
+  })().finally(() => {
+    flushing = undefined;
+  });
+  return flushing;
+}
+export async function queryUserActivity(filter: ActivityFilter) {
+  await flushUserActivity();
+  return {
+    ...(await database().query(filter)),
+    collection: { pending: pending.length, dropped, lastErrorAt },
+  };
+}
