--- /dev/null
+++ b/server/lib/userActivityPolicy.ts
@@ -0,0 +1,170 @@
+import { createHash } from 'crypto';
+export type ActivityKind = 'login' | 'logout' | 'page' | 'action';
+export type ActivityEvent = {
+  at: number;
+  userId: number;
+  session: string;
+  kind: ActivityKind;
+  action: string;
+  target: string | null;
+  device: string;
+  browser: string;
+};
+export function activityPage(raw: unknown): string | null {
+  if (
+    typeof raw !== 'string' ||
+    raw.length > 2048 ||
+    !raw.startsWith('/') ||
+    raw.startsWith('//')
+  )
+    return null;
+  const path = raw.split(/[?#]/)[0].replace(/\/$/, '') || '/';
+  if (
+    [
+      '/',
+      '/for-you',
+      '/lists',
+      '/lists/explore',
+      '/requests',
+      '/issues',
+      '/search',
+      '/profile',
+      '/profile/watchlist',
+    ].includes(path)
+  )
+    return path;
+  if (
+    /^\/(movie|tv|person|collection)\/[1-9]\d*(?:\/(cast|crew|recommendations|similar))?$/.test(
+      path
+    )
+  )
+    return path;
+  if (/^\/lists\/[a-z0-9:_-]{1,160}$/i.test(path)) return path;
+  if (/^\/discover\/[a-z0-9/-]{1,120}$/i.test(path)) return path;
+  if (
+    /^\/users\/[1-9]\d*(?:\/(requests|watchlist|letterboxd-watchlist))?$/.test(
+      path
+    )
+  )
+    return path;
+  if (
+    /^\/(?:settings|profile\/settings|users\/[1-9]\d*\/settings)(?:\/[a-z-]{1,50}){0,3}$/.test(
+      path
+    )
+  )
+    return path;
+  if (/^\/issues\/[1-9]\d*$/.test(path)) return path;
+  return null;
+}
+export function activityIdentity(userId: unknown, sessionId: unknown, ua = '') {
+  if (
+    !Number.isSafeInteger(userId) ||
+    Number(userId) < 1 ||
+    typeof sessionId !== 'string' ||
+    !sessionId
+  )
+    return null;
+  return {
+    userId: Number(userId),
+    session: createHash('sha256').update(sessionId).digest('hex'),
+    device: /ipad|tablet/i.test(ua)
+      ? 'Tablet'
+      : /mobile|iphone|android/i.test(ua)
+        ? 'Mobile'
+        : ua
+          ? 'Desktop'
+          : 'Unknown',
+    browser: /edg\//i.test(ua)
+      ? 'Edge'
+      : /firefox|fxios/i.test(ua)
+        ? 'Firefox'
+        : /chrome|crios/i.test(ua)
+          ? 'Chrome'
+          : /safari/i.test(ua)
+            ? 'Safari'
+            : 'Other',
+  };
+}
+export function activityAction(
+  method: string,
+  raw: string,
+  body: Record<string, unknown> | null = {}
+): { kind: ActivityKind; action: string; target: string | null } | null {
+  body = body && typeof body === 'object' ? body : {};
+  const p = raw.split('?')[0].replace(/^\/api\/v1/, '');
+  if (
+    method === 'POST' &&
+    /^\/auth\/(plex|local|jellyfin(?:\/quickconnect\/authenticate)?)$/.test(p)
+  )
+    return { kind: 'login', action: 'Signed in', target: null };
+  if (method === 'POST' && p === '/auth/logout')
+    return { kind: 'logout', action: 'Signed out', target: null };
+  if (!['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) return null;
+  if (/^\/request(?:\/|$)/.test(p)) {
+    const target =
+      Number.isSafeInteger(body.mediaId) &&
+      Number(body.mediaId) > 0 &&
+      ['movie', 'tv'].includes(String(body.mediaType))
+        ? `/${body.mediaType}/${body.mediaId}`
+        : '/requests';
+    return {
+      kind: 'action',
+      action:
+        method === 'DELETE'
+          ? 'Deleted request'
+          : method === 'POST'
+            ? 'Requested media'
+            : 'Updated request',
+      target,
+    };
+  }
+  const reviewType =
+    new URL(raw, 'https://activity.invalid').searchParams.get('mediaType') ===
+      'tv' || body.mediaType === 'tv'
+      ? 'tv'
+      : 'movie';
+  let m = p.match(/^\/reviews\/(mine|watched)\/([1-9]\d*)$/);
+  if (m)
+    return {
+      kind: 'action',
+      action:
+        method === 'DELETE'
+          ? 'Removed review'
+          : m[1] === 'watched'
+            ? 'Changed watched status'
+            : 'Saved rating or review',
+      target: `/${reviewType}/${m[2]}`,
+    };
+  if (/^\/discovery-lists\/(?:created|import|[a-z0-9:_-]+\/save)/i.test(p))
+    return {
+      kind: 'action',
+      action: p.endsWith('/save')
+        ? 'Changed saved list'
+        : p.endsWith('/import')
+          ? 'Imported list'
+          : method === 'DELETE'
+            ? 'Deleted list'
+            : method === 'POST'
+              ? 'Created list'
+              : 'Edited list',
+      target: '/lists',
+    };
+  m = p.match(/^\/discovery-lists\/follow\/(movie|tv)\/([1-9]\d*)$/);
+  if (m)
+    return {
+      kind: 'action',
+      action: 'Changed release follow',
+      target: `/${m[1]}/${m[2]}`,
+    };
+  if (/^\/watchlist(?:\/|$)/.test(p))
+    return {
+      kind: 'action',
+      action: 'Changed watchlist',
+      target: '/profile/watchlist',
+    };
+  if (/^\/issue(?:Comment)?(?:\/|$)/.test(p))
+    return { kind: 'action', action: 'Updated issue', target: '/issues' };
+  if (/^\/user\/[1-9]\d*\/settings(?:\/|$)/.test(p))
+    return { kind: 'action', action: 'Updated user settings', target: null };
+  return null;
+}
