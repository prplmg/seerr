+import assert from 'node:assert/strict';
+import { it } from 'node:test';
+import {
+  activityAction,
+  activityIdentity,
+  activityPage,
+} from './userActivityPolicy';
+it('records only safe routes without search queries, reset tokens or arbitrary URLs', () => {
+  assert.equal(activityPage('/movie/42?token=secret#review'), '/movie/42');
+  assert.equal(activityPage('/search?query=private'), '/search');
+  for (const p of [
+    '/resetpassword/secret',
+    '//evil.example',
+    'https://evil.example',
+    '/movie/1/../../secret',
+    '/unknown/private',
+    null,
+  ])
+    assert.equal(activityPage(p), null);
+});
+it('hashes session identity and retains only coarse device/browser', () => {
+  const id = activityIdentity(5, 'private-cookie', 'Mozilla iPhone Safari');
+  assert.equal(id?.userId, 5);
+  assert.equal(id?.device, 'Mobile');
+  assert.equal(id?.browser, 'Safari');
+  assert.match(id!.session, /^[a-f0-9]{64}$/);
+  assert(!JSON.stringify(id).includes('private-cookie'));
+  assert.equal(activityIdentity('5', 'cookie'), null);
+  assert.equal(activityIdentity(5, ''), null);
+});
+it('ignores polling and strips form contents from successful action descriptions', () => {
+  assert.equal(activityAction('GET', '/api/v1/request'), null);
+  assert.equal(activityAction('POST', '/api/v1/activity/page'), null);
+  const e = activityAction('POST', '/api/v1/reviews/mine/42?mediaType=tv', {
+    review: 'secret',
+    password: 'secret',
+  });
+  assert.equal(e?.target, '/tv/42');
+  assert(!JSON.stringify(e).includes('secret'));
+  assert.equal(
+    activityAction('POST', '/api/v1/auth/local', { password: 'secret' })?.kind,
+    'login'
+  );
+  assert.equal(
+    activityAction('PUT', '/api/v1/discovery-lists/created/42')?.action,
+    'Edited list'
+  );
+  assert.equal(
+    activityAction('PUT', '/api/v1/discovery-lists/follow/tv/42')?.target,
+    '/tv/42'
+  );
+  assert.equal(
+    activityAction('POST', '/api/v1/request', null)?.target,
+    '/requests'
+  );
+});
diff --git a/server/lib/userActivityPolicy.ts b/server/lib/userActivityPolicy.ts
