@@ -0,0 +1,90 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { it } from 'node:test';
+import type { ActivityEvent } from './userActivityPolicy';
+import { UserActivityStore } from './userActivityStore';
+it('persists across restart, retains 30 days, isolates users/sessions and paginates accurately', async () => {
+  const dir = await mkdtemp(path.join(tmpdir(), 'usage-test-'));
+  const file = path.join(dir, 'activity.db');
+  let db = new UserActivityStore(file);
+  const now = Date.now();
+  const event = (at: number, userId = 1, session = 'a'): ActivityEvent => ({
+    at,
+    userId,
+    session,
+    kind: 'page',
+    action: 'Opened page',
+    target: '/movie/42',
+    device: 'Mobile',
+    browser: 'Safari',
+  });
+  try {
+    await Promise.all([
+      db.append(
+        [
+          event(now - 31 * 86400000),
+          ...Array.from({ length: 55 }, (_, i) => event(now - i)),
+        ],
+        now
+      ),
+      db.append(
+        [{ ...event(now, 2, 'b'), kind: 'login', action: 'Signed in' }],
+        now
+      ),
+    ]);
+    const result = await db.query({ days: 30, page: 1 }, now);
+    assert.equal(result.totals.total, 56);
+    assert.equal(result.events.length, 50);
+    assert.equal((await db.query({ days: 30, page: 2 }, now)).events.length, 6);
+    assert.equal(
+      (
+        await db.query(
+          { days: 30, page: 1, userId: 2, session: 'b', kind: 'login' },
+          now
+        )
+      ).totals.total,
+      1
+    );
+    await db.close();
+    db = new UserActivityStore(file);
+    assert.equal((await db.query({ days: 30, page: 1 }, now)).totals.total, 56);
+    assert.equal(
+      (await db.query({ days: 30, page: 1 }, now + 31 * 86400000)).totals.total,
+      0
+    );
+  } finally {
+    await db.close();
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+it('caps retained events at 100,000', async () => {
+  const sqlite = (await import('sqlite3')).default;
+  const dir = await mkdtemp(path.join(tmpdir(), 'usage-cap-'));
+  const filename = path.join(dir, 'activity.db');
+  const now = Date.now();
+  let db = new UserActivityStore(filename);
+  try {
+    await db.query({ days: 30, page: 1 }, now);
+    await db.close();
+    const raw = new sqlite.Database(filename);
+    await new Promise<void>((resolve, reject) =>
+      raw.exec(
+        `WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM n WHERE x<100005) INSERT INTO activity(at,userId,session,kind,action,target,device,browser) SELECT ${now},1,'a','page','Opened page','/','Desktop','Safari' FROM n`,
+        (e) => (e ? reject(e) : resolve())
+      )
+    );
+    await new Promise<void>((resolve, reject) =>
+      raw.close((e) => (e ? reject(e) : resolve()))
+    );
+    db = new UserActivityStore(filename);
+    assert.equal(
+      (await db.query({ days: 30, page: 1 }, now)).totals.total,
+      100000
+    );
+  } finally {
+    await db.close();
+    await rm(dir, { recursive: true, force: true });
+  }
+});
diff --git a/server/lib/userActivityStore.ts b/server/lib/userActivityStore.ts
new file mode 100644
index 00000000..4dc67273
--- /dev/null
+++ b/server/lib/userActivityStore.ts
@@ -0,0 +1,139 @@
+import sqlite3 from 'sqlite3';
+import type { ActivityEvent, ActivityKind } from './userActivityPolicy';
+export type ActivityFilter = {
+  days: number;
+  userId?: number;
+  kind?: ActivityKind;
+  session?: string;
+  page: number;
+};
+export class UserActivityStore {
+  private db!: sqlite3.Database;
+  private ready: Promise<void>;
+  private serial: Promise<unknown> = Promise.resolve();
+  private maintenance?: ReturnType<typeof setInterval>;
+  constructor(filename: string) {
+    this.ready = new Promise<void>((resolve, reject) => {
+      this.db = new sqlite3.Database(filename, (error) =>
+        error ? reject(error) : resolve()
+      );
+    })
+      .then(() =>
+        this
+          .exec(`PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL; PRAGMA busy_timeout=1000;
+      CREATE TABLE IF NOT EXISTS activity (id INTEGER PRIMARY KEY AUTOINCREMENT, at INTEGER NOT NULL, userId INTEGER NOT NULL, session TEXT NOT NULL, kind TEXT NOT NULL, action TEXT NOT NULL, target TEXT, device TEXT NOT NULL, browser TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS activity_at ON activity(at DESC,id DESC);
+      CREATE INDEX IF NOT EXISTS activity_user_at ON activity(userId,at DESC);
+      CREATE INDEX IF NOT EXISTS activity_session_at ON activity(session,at DESC);`)
+      )
+      .then(() => {
+        this.maintenance = setInterval(() => {
+          void this.job(() => this.prune(Date.now())).catch(() => {});
+        }, 3600000);
+        this.maintenance.unref();
+      });
+  }
+  private exec(sql: string): Promise<void> {
+    return new Promise((resolve, reject) =>
+      this.db.exec(sql, (e) => (e ? reject(e) : resolve()))
+    );
+  }
+  private all<T = Record<string, unknown>>(
+    sql: string,
+    args: unknown[] = []
+  ): Promise<T[]> {
+    return new Promise((resolve, reject) =>
+      this.db.all(sql, args, (e, rows) =>
+        e ? reject(e) : resolve(rows as T[])
+      )
+    );
+  }
+  private run(sql: string, args: unknown[] = []): Promise<void> {
+    return new Promise((resolve, reject) =>
+      this.db.run(sql, args, (e) => (e ? reject(e) : resolve()))
+    );
+  }
+  private job<T>(fn: () => Promise<T>): Promise<T> {
+    const result = this.serial.then(() => this.ready).then(fn);
+    this.serial = result.catch(() => {});
+    return result;
+  }
+  private async prune(now: number) {
+    await this.run('DELETE FROM activity WHERE at < ?', [now - 30 * 86400000]);
+    await this.exec(
+      'DELETE FROM activity WHERE id IN (SELECT id FROM activity ORDER BY at DESC,id DESC LIMIT -1 OFFSET 100000)'
+    );
+  }
+  append(events: ActivityEvent[], now = Date.now()) {
+    return this.job(async () => {
+      await this.exec('BEGIN IMMEDIATE');
+      try {
+        for (const e of events)
+          await this.run(
+            'INSERT INTO activity(at,userId,session,kind,action,target,device,browser) VALUES(?,?,?,?,?,?,?,?)',
+            [
+              e.at,
+              e.userId,
+              e.session,
+              e.kind,
+              e.action,
+              e.target,
+              e.device,
+              e.browser,
+            ]
+          );
+        await this.prune(now);
+        await this.exec('COMMIT');
+      } catch (error) {
+        await this.exec('ROLLBACK');
+        throw error;
+      }
+    });
+  }
+  query(filter: ActivityFilter, now = Date.now()) {
+    return this.job(async () => {
+      await this.prune(now);
+      const where = ['at >= ?'],
+        params: unknown[] = [now - filter.days * 86400000];
+      if (filter.userId) {
+        where.push('userId = ?');
+        params.push(filter.userId);
+      }
+      if (filter.kind) {
+        where.push('kind = ?');
+        params.push(filter.kind);
+      }
+      if (filter.session) {
+        where.push('session = ?');
+        params.push(filter.session);
+      }
+      const clause = where.join(' AND ');
+      const events = await this.all<ActivityEvent & { id: number }>(
+        `SELECT * FROM activity WHERE ${clause} ORDER BY at DESC,id DESC LIMIT 50 OFFSET ?`,
+        [...params, (filter.page - 1) * 50]
+      );
+      const totals = (
+        await this.all(
+          `SELECT COUNT(*) AS total,COUNT(DISTINCT userId) AS users,COUNT(DISTINCT session) AS sessions,COALESCE(SUM(kind='page'),0) AS pages,COALESCE(SUM(kind='action'),0) AS actions,COALESCE(SUM(kind='login'),0) AS logins FROM activity WHERE ${clause}`,
+          params
+        )
+      )[0];
+      return {
+        events,
+        totals,
+        retentionDays: 30,
+        maxEvents: 100000,
+        page: filter.page,
+      };
+    });
+  }
+  async close() {
+    await this.ready;
+    if (this.maintenance) clearInterval(this.maintenance);
+    await this.serial;
+    await this.ready;
+    await new Promise<void>((resolve, reject) =>
+      this.db.close((e) => (e ? reject(e) : resolve()))
+    );
+  }
+}
