@@ -0,0 +1,30 @@
+import { recordUserActivity } from '@server/lib/userActivity';
+import {
+  activityAction,
+  activityIdentity,
+} from '@server/lib/userActivityPolicy';
+import type { NextFunction, Request, Response } from 'express';
+// Count successful interactive actions, never polling or service/API-key work.
+export function userActivityMiddleware(
+  req: Request,
+  res: Response,
+  next: NextFunction
+) {
+  if (req.header('X-Api-Key')) return next();
+  const action = activityAction(req.method, req.originalUrl, req.body);
+  if (!action) return next();
+  const initialUser = req.session?.userId;
+  const session = req.sessionID;
+  const agent = req.header('user-agent') || '';
+  res.once('finish', () => {
+    if (res.statusCode < 200 || res.statusCode >= 300) return;
+    const identity = activityIdentity(
+      action.kind === 'login' ? req.session?.userId : initialUser,
+      action.kind === 'login' ? req.sessionID : session,
+      agent
+    );
+    if (identity)
+      recordUserActivity({ ...identity, ...action, at: Date.now() });
+  });
+  next();
+}
