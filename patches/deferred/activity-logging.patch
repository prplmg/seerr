--- /dev/null
+++ b/server/routes/userActivity.ts
@@ -0,0 +1,98 @@
+import { getRepository } from '@server/datasource';
+import { User } from '@server/entity/User';
+import { Permission } from '@server/lib/permissions';
+import {
+  queryUserActivity,
+  recordUserActivity,
+} from '@server/lib/userActivity';
+import {
+  activityIdentity,
+  activityPage,
+  type ActivityKind,
+} from '@server/lib/userActivityPolicy';
+import { isAuthenticated } from '@server/middleware/auth';
+import { Router } from 'express';
+import rateLimit from 'express-rate-limit';
+const router = Router();
+router.use(isAuthenticated());
+router.use((_req, res, next) => {
+  res.setHeader('Cache-Control', 'private, no-store');
+  next();
+});
+router.post(
+  '/page',
+  rateLimit({
+    windowMs: 60000,
+    limit: 60,
+    keyGenerator: (req) => String(req.user!.id),
+  }),
+  (req, res) => {
+    // Actor and time come from the authenticated session, not telemetry input.
+    if (req.header('X-Api-Key') || req.session?.userId !== req.user!.id)
+      return res.sendStatus(403);
+    if (!req.body || Object.keys(req.body).some((k) => k !== 'path'))
+      return res.sendStatus(400);
+    const target = activityPage(req.body.path),
+      identity = activityIdentity(
+        req.user!.id,
+        req.sessionID,
+        req.header('user-agent')
+      );
+    if (!target || !identity) return res.sendStatus(400);
+    recordUserActivity({
+      ...identity,
+      at: Date.now(),
+      kind: 'page',
+      action: 'Opened page',
+      target,
+    });
+    return res.sendStatus(204);
+  }
+);
+router.get('/', isAuthenticated(Permission.ADMIN), async (req, res) => {
+  const days = Number(req.query.days ?? 7),
+    page = Number(req.query.page ?? 1),
+    userId =
+      req.query.userId === undefined ? undefined : Number(req.query.userId),
+    kind = req.query.kind as ActivityKind | undefined,
+    session = req.query.session;
+  if (
+    !Number.isInteger(days) ||
+    days < 1 ||
+    days > 30 ||
+    !Number.isInteger(page) ||
+    page < 1 ||
+    page > 2000 ||
+    (userId !== undefined && (!Number.isSafeInteger(userId) || userId < 1)) ||
+    (kind !== undefined &&
+      !['login', 'logout', 'page', 'action'].includes(kind)) ||
+    (session !== undefined &&
+      (typeof session !== 'string' || !/^[a-f0-9]{64}$/.test(session)))
+  )
+    return res.sendStatus(400);
+  try {
+    const [result, users] = await Promise.all([
+      queryUserActivity({
+        days,
+        page,
+        userId,
+        kind,
+        session: session as string | undefined,
+      }),
+      getRepository(User).find(),
+    ]);
+    return res.json({
+      ...result,
+      users: users.map((u) => ({
+        id: u.id,
+        name: u.displayName,
+        avatar: u.avatar,
+      })),
+    });
+  } catch {
+    return res
+      .status(503)
+      .json({ error: 'Activity history is temporarily unavailable' });
+  }
+});
+export default router;
