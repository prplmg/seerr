@@ -0,0 +1,354 @@
+import PageTitle from '@app/components/Common/PageTitle';
+import { Permission, useUser } from '@app/hooks/useUser';
+import Link from 'next/link';
+import { useState } from 'react';
+import { useIntl } from 'react-intl';
+import useSWR from 'swr';
+
+type Activity = {
+  id: number;
+  at: number;
+  userId: number;
+  session: string;
+  kind: string;
+  action: string;
+  target: string | null;
+  device: string;
+  browser: string;
+};
+export type UserActivityData = {
+  events: Activity[];
+  users: { id: number; name: string; avatar: string }[];
+  totals: {
+    total: number;
+    users: number;
+    sessions: number;
+    pages: number;
+    actions: number;
+    logins: number;
+  };
+  page: number;
+  retentionDays: number;
+  collection: { dropped: number; lastErrorAt: number | null };
+};
+const pageName = (path: string, es: boolean) => {
+  const names: Record<string, string> = {
+    '/': es ? 'Descubrir' : 'Discover',
+    '/for-you': es ? 'Para ti' : 'For you',
+    '/lists': es ? 'Mis listas' : 'My lists',
+    '/lists/explore': es ? 'Explorar listas' : 'Explore lists',
+    '/requests': es ? 'Solicitudes' : 'Requests',
+    '/search': es ? 'Búsqueda' : 'Search',
+    '/profile': es ? 'Perfil' : 'Profile',
+    '/issues': es ? 'Problemas' : 'Issues',
+  };
+  if (names[path]) return names[path];
+  const m = path.match(/^\/(movie|tv)\/(\d+)$/);
+  if (m)
+    return `${m[1] === 'movie' ? (es ? 'Película' : 'Movie') : es ? 'Serie' : 'Series'} #${m[2]}`;
+  return path;
+};
+export function UserActivityView({
+  data,
+  error,
+  loading,
+  days,
+  setDays,
+  userId,
+  setUserId,
+  kind,
+  setKind,
+  session,
+  setSession,
+  page,
+  setPage,
+  refresh,
+  es = false,
+}: {
+  data?: UserActivityData;
+  error?: boolean;
+  loading?: boolean;
+  days: string;
+  setDays: (v: string) => void;
+  userId: string;
+  setUserId: (v: string) => void;
+  kind: string;
+  setKind: (v: string) => void;
+  session: string;
+  setSession: (v: string) => void;
+  page: number;
+  setPage: (v: number) => void;
+  refresh: () => void;
+  es?: boolean;
+}) {
+  const t = (en: string, spanish: string) => (es ? spanish : en);
+  const select =
+    'rounded-lg border border-gray-600 bg-gray-900 px-3 py-2 text-white';
+  return (
+    <div className="space-y-6">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div>
+          <h1 className="text-2xl font-bold text-purple-300">
+            {t('User activity', 'Actividad de usuarios')}
+          </h1>
+          <p className="mt-1 text-sm text-gray-400">
+            {t(
+              'Sign-ins, pages opened, and successful actions. Kept for 30 days.',
+              'Inicios de sesión, páginas abiertas y acciones completadas. Se conservan 30 días.'
+            )}
+          </p>
+        </div>
+        <button className={select} onClick={refresh}>
+          {t('Refresh', 'Actualizar')}
+        </button>
+      </div>
+      <div className="grid grid-cols-2 gap-3 lg:grid-cols-4">
+        {[
+          [t('Active users', 'Usuarios activos'), data?.totals.users],
+          [t('Page views', 'Páginas vistas'), data?.totals.pages],
+          [t('Actions', 'Acciones'), data?.totals.actions],
+          [t('Sign-ins', 'Inicios de sesión'), data?.totals.logins],
+        ].map(([label, value]) => (
+          <div
+            key={label}
+            className="rounded-xl border border-gray-700 bg-gray-800 p-4"
+          >
+            <div className="text-sm text-gray-400">{label}</div>
+            <div className="mt-1 text-2xl font-semibold">{value ?? '—'}</div>
+          </div>
+        ))}
+      </div>
+      <div className="flex flex-wrap gap-3">
+        <label className="flex flex-col gap-1 text-sm text-gray-400">
+          {t('User', 'Usuario')}
+          <select
+            className={select}
+            value={userId}
+            onChange={(e) => {
+              setUserId(e.target.value);
+              setSession('');
+              setPage(1);
+            }}
+          >
+            <option value="">{t('Everyone', 'Todos')}</option>
+            {data?.users.map((u) => (
+              <option key={u.id} value={u.id}>
+                {u.name || `#${u.id}`}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label className="flex flex-col gap-1 text-sm text-gray-400">
+          {t('Show', 'Mostrar')}
+          <select
+            className={select}
+            value={kind}
+            onChange={(e) => {
+              setKind(e.target.value);
+              setPage(1);
+            }}
+          >
+            <option value="">{t('All activity', 'Toda la actividad')}</option>
+            <option value="page">{t('Browsing', 'Navegación')}</option>
+            <option value="action">{t('Actions', 'Acciones')}</option>
+            <option value="login">{t('Sign-ins', 'Inicios de sesión')}</option>
+            <option value="logout">
+              {t('Sign-outs', 'Cierres de sesión')}
+            </option>
+          </select>
+        </label>
+        <label className="flex flex-col gap-1 text-sm text-gray-400">
+          {t('Period', 'Periodo')}
+          <select
+            className={select}
+            value={days}
+            onChange={(e) => {
+              setDays(e.target.value);
+              setPage(1);
+            }}
+          >
+            {[1, 7, 30].map((n) => (
+              <option key={n} value={n}>
+                {t(`Last ${n} days`, `Últimos ${n} días`)}
+              </option>
+            ))}
+          </select>
+        </label>
+      </div>
+      {session && (
+        <div className="flex items-center gap-3 rounded-lg bg-purple-900/30 px-3 py-2 text-sm">
+          <span>{t('Showing one session', 'Mostrando una sesión')}</span>
+          <button
+            className="text-purple-300 underline"
+            onClick={() => {
+              setSession('');
+              setPage(1);
+            }}
+          >
+            {t('Clear', 'Quitar filtro')}
+          </button>
+        </div>
+      )}
+      {!!data?.collection.dropped && (
+        <p role="status" className="text-yellow-300">
+          {t(
+            'Some activity could not be recorded. The history may be incomplete.',
+            'No se pudo registrar parte de la actividad. El historial puede estar incompleto.'
+          )}
+        </p>
+      )}
+      {error ? (
+        <p role="alert">
+          {t(
+            'Activity could not be loaded. Try refreshing.',
+            'No se pudo cargar la actividad. Intenta actualizar.'
+          )}
+        </p>
+      ) : loading || !data ? (
+        <p role="status" className="animate-pulse text-gray-400">
+          {t('Loading activity…', 'Cargando actividad…')}
+        </p>
+      ) : !data.events.length ? (
+        <div className="rounded-xl border border-gray-700 bg-gray-800 p-8 text-center text-gray-400">
+          {t(
+            'No activity in this period. New visits will appear here after logging is enabled.',
+            'No hay actividad en este periodo. Las nuevas visitas aparecerán aquí después de activar el registro.'
+          )}
+        </div>
+      ) : (
+        <div className="divide-y divide-gray-700 overflow-hidden rounded-xl border border-gray-700 bg-gray-800">
+          {data.events.map((event) => {
+            const user = data.users.find((u) => u.id === event.userId);
+            return (
+              <article
+                key={event.id}
+                className="flex min-w-0 flex-col gap-2 p-4 sm:flex-row sm:items-start sm:gap-4"
+              >
+                <time
+                  className="shrink-0 text-sm text-gray-400 sm:w-40"
+                  dateTime={new Date(event.at).toISOString()}
+                >
+                  {new Date(event.at).toLocaleString(es ? 'es-MX' : 'en-US', {
+                    month: 'short',
+                    day: 'numeric',
+                    hour: 'numeric',
+                    minute: '2-digit',
+                  })}
+                </time>
+                <div className="min-w-0 flex-1">
+                  <Link
+                    href={`/users/${event.userId}`}
+                    className="font-semibold text-purple-300"
+                  >
+                    {user?.name || `User #${event.userId}`}
+                  </Link>
+                  <p className="break-words">
+                    {event.action}
+                    {event.target && (
+                      <>
+                        {' '}
+                        ·{' '}
+                        <Link
+                          className="text-purple-300 hover:underline"
+                          href={event.target}
+                        >
+                          {pageName(event.target, es)}
+                        </Link>
+                      </>
+                    )}
+                  </p>
+                  <p className="mt-1 text-xs text-gray-400">
+                    {event.device} · {event.browser}
+                  </p>
+                </div>
+                <button
+                  className="self-start text-sm text-gray-400 hover:text-purple-300"
+                  onClick={() => {
+                    setSession(event.session);
+                    setPage(1);
+                  }}
+                >
+                  {t('View session', 'Ver sesión')}
+                </button>
+              </article>
+            );
+          })}
+        </div>
+      )}
+      <div className="flex items-center justify-between gap-3 text-sm">
+        <button
+          className={select}
+          disabled={page <= 1 || loading}
+          onClick={() => setPage(page - 1)}
+        >
+          {t('Previous', 'Anterior')}
+        </button>
+        <span className="text-gray-400">
+          {t('Page', 'Página')} {page}
+          {data ? ` · ${data.totals.total} ${t('events', 'eventos')}` : ''}
+        </span>
+        <button
+          className={select}
+          disabled={!data || page * 50 >= data.totals.total || loading}
+          onClick={() => setPage(page + 1)}
+        >
+          {t('Next', 'Siguiente')}
+        </button>
+      </div>
+      <p className="text-xs text-gray-500">
+        {t(
+          'Page views show what was opened, not time spent. Background refreshes are excluded. Search text, review contents, passwords and IP addresses are not recorded.',
+          'Las vistas indican qué se abrió, no el tiempo dedicado. Se excluyen las actualizaciones en segundo plano. No se registran búsquedas, reseñas, contraseñas ni direcciones IP.'
+        )}
+      </p>
+    </div>
+  );
+}
+export default function UserActivity() {
+  const { hasPermission } = useUser(),
+    intl = useIntl();
+  const [days, setDays] = useState('7'),
+    [userId, setUserId] = useState(''),
+    [kind, setKind] = useState(''),
+    [session, setSession] = useState(''),
+    [page, setPage] = useState(1);
+  const params = new URLSearchParams({ days, page: String(page) });
+  if (userId) params.set('userId', userId);
+  if (kind) params.set('kind', kind);
+  if (session) params.set('session', session);
+  const { data, error, isLoading, mutate } = useSWR<UserActivityData>(
+    hasPermission(Permission.ADMIN) ? `/api/v1/activity?${params}` : null,
+    { revalidateOnFocus: false }
+  );
+  if (!hasPermission(Permission.ADMIN)) return null;
+  return (
+    <>
+      <PageTitle
+        title={
+          intl.locale.startsWith('es')
+            ? 'Actividad de usuarios'
+            : 'User activity'
+        }
+      />
+      <UserActivityView
+        {...{
+          data,
+          days,
+          setDays,
+          userId,
+          setUserId,
+          kind,
+          setKind,
+          session,
+          setSession,
+          page,
+          setPage,
+        }}
+        error={!!error}
+        loading={isLoading}
+        refresh={() => void mutate()}
+        es={intl.locale.startsWith('es')}
+      />
+    </>
+  );
+}
