@@ -0,0 +1,45 @@
+import { useUser } from '@app/hooks/useUser';
+import axios from 'axios';
+import { useRouter } from 'next/router';
+import { useEffect, useRef } from 'react';
+// Observe completed navigation, not API polling. Keep telemetry off the page's
+// loading path, and never transmit search strings, query parameters or fragments.
+export default function UserActivityTracker() {
+  const { user } = useUser();
+  const router = useRouter();
+  const last = useRef({ userId: 0, path: '', at: 0 });
+  useEffect(() => {
+    if (!user?.id) return;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const send = (url: string) => {
+      if (timer) clearTimeout(timer);
+      const path = url.split(/[?#]/)[0];
+      if (/^\/(login|setup|resetpassword)(\/|$)/.test(path)) return;
+      timer = setTimeout(() => {
+        if (document.visibilityState !== 'visible') return;
+        if (
+          last.current.userId === user.id &&
+          last.current.path === path &&
+          Date.now() - last.current.at < 30 * 60000
+        )
+          return;
+        last.current = { userId: user.id, path, at: Date.now() };
+        void axios.post('/api/v1/activity/page', { path }).catch(() => {
+          /* Usage logging must never interrupt browsing. */
+        });
+      }, 300);
+    };
+    const visible = () => {
+      if (document.visibilityState === 'visible') send(router.asPath);
+    };
+    send(router.asPath);
+    router.events.on('routeChangeComplete', send);
+    document.addEventListener('visibilitychange', visible);
+    return () => {
+      if (timer) clearTimeout(timer);
+      router.events.off('routeChangeComplete', send);
+      document.removeEventListener('visibilitychange', visible);
+    };
+  }, [user?.id, router]);
+  return null;
+}
