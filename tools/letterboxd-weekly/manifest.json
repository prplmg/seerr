{
  "manifest_version": 3,
  "name": "Multimeldia Letterboxd pilot",
  "version": "0.2.50",
  "permissions": ["alarms", "scripting"],
  "host_permissions": ["https://letterboxd.com/*", "https://boxd.it/*", "http://127.0.0.1:18764/*"],
  "action": {"default_title": "Letterboxd pilot: OK = completed, WAIT = needs attention"},
  "background": {"service_worker": "automation.js"}
}
